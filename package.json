{
  "name": "dsh-forge",
  "description": "Skill self-forging for DeepSeek Harness: watch session traces, detect repeated successful tasks, and forge them into reusable skills.",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/activeing123/dsh-forge.git"
  },
  "bugs": {
    "url": "https://github.com/activeing123/dsh-forge/issues"
  },
  "homepage": "https://github.com/activeing123/dsh-forge#readme",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "README.md",
    "README.zh.md",
    "examples/**/*.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "skill",
    "self-improving",
    "agent",
    "plugin"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}